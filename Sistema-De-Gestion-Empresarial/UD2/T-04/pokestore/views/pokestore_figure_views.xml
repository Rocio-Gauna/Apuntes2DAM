<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LISTA de figuras con la columna nueva del valor del stock -->
    <record id="pokestore_figure_view_list" model="ir.ui.view">
        <field name="name">pokestore.figure.list</field>
        <field name="model">pokestore.figure</field>
        <field name="arch" type="xml">
            <list string="Figuras">
                <field name="name"/>
                <field name="pokemon"/>
                <field name="collection_id"/>
                <field name="rarity"/>
                <field name="price"/>
                <field name="stock"/>
                <!-- Columna nueva: el valor calculado (precio por stock) -->
                <field name="stock_value"/>
            </list>
        </field>
    </record>

    <!-- FORMULARIO con el botón, el valor calculado y las notas -->
    <record id="pokestore_figure_view_form" model="ir.ui.view">
        <field name="name">pokestore.figure.form</field>
        <field name="model">pokestore.figure</field>
        <field name="arch" type="xml">
            <form string="Figura">
                <!-- header = la franja de arriba donde van los botones -->
                <header>
                    <!-- name = método de Python que se ejecuta al pulsar -->
                    <!-- type="object" = "llama a un método del modelo" (no abre ventanas) -->
                    <!-- btn-primary = botón de color destacado -->
                    <button name="action_deplete_stock" type="object" string="Agotar stock" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="pokemon"/>
                            <field name="collection_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="rarity"/>
                            <field name="price"/>
                            <field name="stock"/>
                            <!-- Valor calculado: se ve pero no se puede escribir (los calculados son de solo lectura) -->
                            <field name="stock_value"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <!-- Notas internas: aquí se escribe la recomendación automática del onchange -->
                        <field name="internal_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA DE BÚSQUEDA: la barra de arriba para buscar, filtrar y agrupar -->
    <record id="pokestore_figure_view_search" model="ir.ui.view">
        <field name="name">pokestore.figure.search</field>
        <field name="model">pokestore.figure</field>
        <field name="arch" type="xml">
            <search string="Buscar figuras">
                <!-- Al escribir en la barra, Odoo ofrece buscar por nombre -->
                <field name="name"/>
                <!-- ...y por Pokémon -->
                <field name="pokemon"/>
                <!-- Filtro: botón que deja solo las figuras con rareza exclusiva -->
                <!-- domain = condición: [(campo, operador, valor)] -->
                <filter name="filter_exclusive" string="Exclusivas" domain="[('rarity', '=', 'exclusive')]"/>
                <!-- Caja "Agrupar por" -->
                <group expand="0" string="Agrupar por">
                    <!-- Agrupa las figuras por su colección: context={'group_by': campo} -->
                    <filter name="group_collection" string="Colección" context="{'group_by': 'collection_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACCIÓN de figuras (igual que antes) -->
    <!-- No hay que decirle que use la vista de búsqueda: Odoo la coge sola porque es del mismo modelo -->
    <record id="pokestore_figure_action" model="ir.actions.act_window">
        <field name="name">Figuras</field>
        <field name="res_model">pokestore.figure</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>