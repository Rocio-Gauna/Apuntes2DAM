<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Registro de entrenamiento" style="@style/TituloPantalla" />
        <!-- TODO: construye la interfaz completa siguiendo los id del PDF:
             etNombre (texto), etMinutos (entero), etIntensidad (entero), btnRegistrar, btnLimpiar, tvResultado.
             Aplica los estilos definidos en res/values/styles.xml. -->
            <EditText 
            android:id="@+id/etMinutos"
            style="@style/CampoFormulario"
            android:hint="Minutos(1 a 300)"
            android:inputType="number"/>

            </LinearLayout>
</ScrollView>
